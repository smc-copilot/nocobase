# One Nginx Ingress, multiple hostnames. Do not path-prefix Octop or the portal
# onto the same host without a proven rewrite PoC.

# portal.example.com  -> NocoBase employee portal
# octop.example.com   -> Octop
# casdoor.example.com -> Casdoor

server {
    listen 443 ssl;
    server_name portal.example.com;
    # ssl_certificate     /etc/ssl/certs/portal.example.com.crt;
    # ssl_certificate_key /etc/ssl/private/portal.example.com.key;

    location / {
        proxy_pass http://127.0.0.1:13000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

server {
    listen 443 ssl;
    server_name octop.example.com;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

server {
    listen 443 ssl;
    server_name casdoor.example.com;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
